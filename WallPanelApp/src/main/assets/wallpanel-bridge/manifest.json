{
  "manifest_version": 2,
  "name": "WallPanel bridge",
  "version": "1.0",
  "description": "Lets WallPanel run JavaScript commands (MQTT/REST eval) in the dashboard page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@wallpanel.thanksmister.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
